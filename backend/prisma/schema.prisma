// SQLite 用于本地演示；字段类型刻意保持 MySQL 可迁移（无 SQLite 专有类型）。
// 切换 MySQL：把 provider 改为 "mysql"，DATABASE_URL 指向 MySQL，再执行 prisma migrate。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  /// 演示角色：SALES 业务岗 / RISK 风控 / MANAGER 主管
  role      String
  createdAt DateTime @default(now())

  auditLogs        AuditLog[]
  workbenchActions WorkbenchAction[]
  approvals        Shipment[]        @relation("ShipmentApprover")
  occupancyClaims    OccupancyReview[] @relation("OccupancyClaimedBy")
  occupancyDecisions OccupancyReview[] @relation("OccupancyDecidedBy")
  taxFinanceClaims    TaxFinanceReview[] @relation("TaxFinanceClaimedBy")
  taxFinanceDecisions TaxFinanceReview[] @relation("TaxFinanceDecidedBy")
}

/// 客户主数据：案件到达 N3 后由买方录入；按规范化名称+国家或税号合并，跨案件查看限额与收汇
model Customer {
  id              String   @id @default(cuid())
  name            String
  nameEn          String?
  country         String?
  address         String?
  registrationNo  String?
  /// 规范化名称（去后缀、忽略大小写），与 countryKey 一起作为合并键
  nameKey         String
  /// 规范化国家码；未填则为空字符串
  countryKey      String   @default("")
  /// 规范化注册号/税号；未填则为 null
  registrationKey String?
  note            String?
  createdAt       DateTime @default(now())

  parties Party[]

  @@unique([nameKey, countryKey])
  @@index([registrationKey])
}

/// 国内供应商主数据：由 N5 Party SUPPLIER 聚合，跨案件查看采购单、交货与货款
model Supplier {
  id             String   @id @default(cuid())
  name           String   @unique
  nameEn         String?
  country        String?
  address        String?
  registrationNo String?
  note           String?
  createdAt      DateTime @default(now())

  parties Party[]
}

/// 出口案件（询盘→收汇全流程载体）
model TradeCase {
  id          String   @id @default(cuid())
  caseNo      String   @unique
  title       String
  scenario    String
  status      String
  currentNode String
  overallRisk String
  goodsDesc   String
  /// 规格（与货物名称分列，贯通 N1/N2/N3）
  goodsSpec   String?
  destination String
  amountFen   Int
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parties           Party[]
  nodes             CaseNode[]
  hits              ScreeningHit[]
  kycReports        KycReport[]
  contract          Contract?
  shipment          Shipment?
  documents         TradeDocument[]
  mismatchFixes     DocMismatchFix[]
  settlement        Settlement?
  auditLogs         AuditLog[]
  workbench         WorkbenchAction[]
  gateChecks        GateCheck[]
  quotes                  Quote[]
  changeOrders            ChangeOrder[]
  contractVersions        ContractVersion[]
  procurementPlan         ProcurementPlan? @relation("CaseOwnsProcurement")
  salesLinkedProcurements ProcurementPlan[] @relation("SalesLinkedProcurement")
  customs                 CustomsDeclaration?
  evidences               Evidence[]
  sinosurePolicies        SinosurePolicy[]
  occupancyReviews        OccupancyReview[]
  taxFinanceReviews       TaxFinanceReview[]
  taxRebateChecklist      TaxRebateChecklist?
}

model Party {
  id             String          @id @default(cuid())
  caseId         String
  customerId     String?
  supplierId     String?
  role           String
  name           String
  nameEn         String?
  country        String?
  address        String?
  registrationNo String?
  isSameAsBuyer  Boolean         @default(true)
  relationNote   String?
  case           TradeCase       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  hits           ScreeningHit[]

  @@index([caseId, role])
  @@index([customerId])
  @@index([supplierId])
}

model CaseNode {
  id          String    @id @default(cuid())
  caseId      String
  code        String
  name        String
  status      String
  decision    String?
  isStub      Boolean   @default(false)
  isHardGate  Boolean   @default(false)
  summary     String?
  startedAt   DateTime?
  completedAt DateTime?
  case        TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, code])
}

model BlacklistEntry {
  id       String  @id @default(cuid())
  listCode String
  name     String
  country  String?
  aliases  String
  note     String?
}

model ScreeningHit {
  id          String            @id @default(cuid())
  caseId      String
  partyId     String
  nodeCode    String            @default("N1")
  listCode    String
  listedName  String
  matchedName String
  confidence  String
  riskLevel   String
  disposition String            @default("OPEN")
  score       Int
  rawJson     String
  createdAt   DateTime          @default(now())
  case        TradeCase         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  party       Party             @relation(fields: [partyId], references: [id], onDelete: Cascade)
  actions     WorkbenchAction[]

  @@index([caseId, disposition])
  @@index([caseId, nodeCode])
}

model KycReport {
  id        String    @id @default(cuid())
  caseId    String
  nodeCode  String    @default("N1")
  score     Int
  riskLevel String
  summary   String
  payload   String
  createdAt DateTime  @default(now())
  case      TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, nodeCode])
}

model Contract {
  id                  String    @id @default(cuid())
  caseId              String    @unique
  counterparty        String
  /// 运输术语（Incoterms）：FOB / CIF / CIP 等。不得写入 T/T 等结算方式
  incoterms           String?
  /// 结算/付款条件：L/C、OA、前 T/T、后 T/T 30 days 等。与 incoterms 独立
  paymentTerms        String?
  hasRetentionOfTitle Boolean   @default(false)
  hasDisputeClause    Boolean   @default(false)
  isFinal             Boolean   @default(false)
  goodsDesc           String?
  /// 规格（与货物名称分列，贯通 N1/N2/N3）
  goodsSpec           String?
  amountFen           Int?
  currency            String    @default("USD")
  destination         String?
  buyerName           String?
  consigneeName       String?
  deliveryDate        DateTime?
  quantity            Int?
  unit                String?
  /// 约定客户付款日期 / 约定收汇到期日。优先手填；否则由交货期 + 付款条件中的账期天数推算（如 T/T 30 days）
  paymentDueAt        DateTime?
  /// CIF/CIP 装运港口
  shipmentPort        String?
  /// CIF/CIP 装运日期
  shipmentDate        DateTime?
  /// FOB/EXW/FAS/FCA：国内段到达口岸/港口时间；到达即完成国内交付
  domesticPortArrivalAt DateTime?
  /// 电汇结算子类：ADVANCE 前 T/T / AFTER 后 T/T。独立于运输术语，可与 FOB/CIF 组合
  ttTiming            String?
  /// 前 T/T 预付款比例（基点，10000=100%）
  ttPercentBps        Int?
  /// 前 T/T 约定预付款金额（分）；空则按比例×合同额
  ttAdvanceFen        Int?
  /// 后 T/T 装运后付款天数
  ttDaysAfterShipment Int?
  /// 货物状态：预计到达日期
  etaDate             DateTime?
  /// 货物状态：到达港口（预计到达哪个港口）
  arrivalPort         String?
  /// 客户是否提货：true 已提货 / false 未提货 / null 未填
  customerPickedUp    Boolean?
  /// 是否收汇（展示缓存）。已回款只认 N9 Settlement 水单/到账；保存销售合同时不改本字段
  hasRemittance       Boolean   @default(false)
  /// 已收汇金额（分）展示缓存，由 N9 到账回写；未收汇 = 合同总额 − N9 到账
  remittedFen         Int       @default(0)
  /// 交货方式：OWN_WAREHOUSE 自有仓 | BONDED 保税（遗留） | DIRECT_PORT 港口直出。本轮表单仅自有仓 / 港口直出。
  deliveryMode        String?
  /// 港口直出：货物仓储地点 / 批次号 / 电子底账编号（JSON）。自有仓可空。
  directPortJson      String?
  /// 前 T/T 收汇水单/凭证（JSON 数组：{ ref, fileName }）
  ttVoucherJson       String?
  updatedAt           DateTime  @updatedAt
  case                TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model Shipment {
  id                            String    @id @default(cuid())
  caseId                        String    @unique
  hasCustomerWrittenInstruction Boolean   @default(false)
  instructionRef                String?
  hasInternalApproval           Boolean   @default(false)
  approverId                    String?
  blControl                     String?
  blNo                          String?
  vessel                        String?
  consigneeOnBl                 String?
  noBlReason                    String?
  noBlRef                       String?
  noBlEvidenceStub              String?
  incotermsOverride             String?
  updatedAt                     DateTime  @updatedAt
  case                          TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  approver                      User?     @relation("ShipmentApprover", fields: [approverId], references: [id])
}

model TradeDocument {
  id         String    @id @default(cuid())
  caseId     String
  type       String
  isFinal    Boolean   @default(false)
  fieldsJson String
  createdAt  DateTime  @default(now())
  case       TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, type])
}

model DocMismatchFix {
  id        String    @id @default(cuid())
  caseId    String
  field     String
  fromValue String
  toValue   String
  reason    String
  createdAt DateTime  @default(now())
  case      TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model Settlement {
  id                     String    @id @default(cuid())
  caseId                 String    @unique
  payerName              String
  buyerName              String
  isThirdParty           Boolean   @default(false)
  hasThirdPartyProof     Boolean   @default(false)
  thirdPartyProofRef     String?
  hasRemittanceMemo      Boolean   @default(false)
  remittanceMemoRef      String?
  hasDocConsistencyProof Boolean   @default(false)
  hasReleaseApproval     Boolean   @default(false)
  amountFen              Int?
  /// 实际到账/收汇日期，与合同 paymentDueAt 比较得出按期/逾期。已回款（列表已完成 / 占用释放）只认本表水单或到账。
  receivedAt             DateTime?
  updatedAt              DateTime  @updatedAt
  case                   TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

/// 中信保占用高风险审核（领取 / 放行 / 驳回）。超高风险不入列；中风险不入列。
model OccupancyReview {
  id              String   @id @default(cuid())
  caseId          String
  nodeCode        String
  status          String
  band            String   @default("HIGH")
  occupancyFen    Int
  excessFen       Int
  insuredLimitFen Int
  currency        String   @default("USD")
  fingerprint     String
  claimedById     String?
  claimedAt       DateTime?
  decidedById     String?
  decidedAt       DateTime?
  comment         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  case            TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  claimedBy       User?     @relation("OccupancyClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)
  decidedBy       User?     @relation("OccupancyDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  actions         WorkbenchAction[]

  @@index([caseId, nodeCode])
  @@index([status])
  @@index([fingerprint])
}

/// 出口退税 / 融资性贸易审核（领取 / 通过 / 驳回）。黄灯入列；红线硬拦截（可只读展示）。
model TaxFinanceReview {
  id          String   @id @default(cuid())
  caseId      String
  nodeCode    String
  status      String
  band        String
  reasonCode  String
  summary     String
  fingerprint String
  claimedById String?
  claimedAt   DateTime?
  decidedById String?
  decidedAt   DateTime?
  comment     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  case        TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  claimedBy   User?     @relation("TaxFinanceClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)
  decidedBy   User?     @relation("TaxFinanceDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  actions     WorkbenchAction[]

  @@index([caseId, nodeCode])
  @@index([status])
  @@index([fingerprint])
}

/// 退税就绪清单（FT4）：报关放行与 N9 收汇由系统推导；进项发票号可手填；四流闭环须勾选。
model TaxRebateChecklist {
  id             String    @id @default(cuid())
  caseId         String    @unique
  inputInvoiceNo String?
  flowGoods      Boolean   @default(false)
  flowCustoms    Boolean   @default(false)
  flowInvoice    Boolean   @default(false)
  flowRemittance Boolean   @default(false)
  declaredAt     DateTime?
  updatedAt      DateTime  @updatedAt
  case           TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

/// 案例工作台处置（筛查命中 + 占用高风险领取/放行/驳回 + 退税·融资性审核）
model WorkbenchAction {
  id                 String            @id @default(cuid())
  caseId             String
  hitId              String?
  occupancyReviewId  String?
  taxFinanceReviewId String?
  actorId            String?
  action             String
  comment            String?
  createdAt          DateTime          @default(now())
  case               TradeCase         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  hit                ScreeningHit?     @relation(fields: [hitId], references: [id], onDelete: SetNull)
  occupancyReview    OccupancyReview?  @relation(fields: [occupancyReviewId], references: [id], onDelete: SetNull)
  taxFinanceReview   TaxFinanceReview? @relation(fields: [taxFinanceReviewId], references: [id], onDelete: SetNull)
  actor              User?             @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([occupancyReviewId])
  @@index([taxFinanceReviewId])
}

/// 仅追加审计日志：禁止更新/删除接口
model AuditLog {
  id        String     @id @default(cuid())
  caseId    String?
  actorId   String?
  action    String
  nodeCode  String?
  detail    String
  createdAt DateTime   @default(now())
  case      TradeCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  actor     User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
}

model GateCheck {
  id          String    @id @default(cuid())
  caseId      String
  nodeCode    String
  decision    String
  canProceed  Boolean
  missingJson String
  reasonsJson String
  createdAt   DateTime  @default(now())
  case        TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

/// N2 报价版本（旧版 SUPERSEDED，禁止硬删除）
model Quote {
  id                String    @id @default(cuid())
  caseId            String
  version           Int
  status            String
  priceBasis        String
  includedItems     String?
  excludedItems     String?
  /// 货物名称（报价页可改，带入 N3）
  goodsDesc         String?
  /// 规格
  goodsSpec         String?
  validityUntil     DateTime?
  freightBearer     String?
  taxBearer         String?
  unitPriceFen      Int?
  /** 单价计量单位：TON 吨 / KG 千克 */
  unit              String?
  quantity          Int?
  amountFen         Int?
  currency          String    @default("USD")
  notes             String?
  abnormalPriceNote String?
  snapshotJson      String
  createdAt         DateTime  @default(now())
  case              TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, version])
  @@index([caseId, status])
}

/// 成本底线（演示用，供报价偏离校验）
model CostFloor {
  id        String @id @default(cuid())
  goodsKey  String @unique
  goodsDesc String
  floorFen  Int
  currency  String @default("USD")
}

/// 历史成交/报价（演示用）
model HistoricalPrice {
  id           String   @id @default(cuid())
  goodsKey     String
  counterparty String?
  unitPriceFen Int
  currency     String   @default("USD")
  quotedAt     DateTime
}

/// N4 变更单（旧版 SUPERSEDED，禁止硬删除）
model ChangeOrder {
  id                     String       @id @default(cuid())
  caseId                 String
  changeNo               String
  version                Int
  status                 String
  reason                 String?
  isSensitive            Boolean      @default(false)
  customerAck            Boolean      @default(false)
  customerAckRef         String?
  customerAckEvidenceId  String?
  customerAckedAt        DateTime?
  internalAck            Boolean      @default(false)
  internalAckEvidenceId  String?
  internalAckedAt        DateTime?
  approved               Boolean      @default(false)
  approvalEvidenceId     String?
  approvedAt             DateTime?
  appliedAt              DateTime?
  createdAt              DateTime     @default(now())
  case                   TradeCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  diffs                  ChangeDiff[]
  sinosurePolicies       SinosurePolicy[]

  @@unique([caseId, changeNo])
  @@index([caseId, status])
}

model ChangeDiff {
  id            String      @id @default(cuid())
  changeOrderId String
  field         String
  fieldLabel    String
  oldValue      String
  newValue      String
  changeOrder   ChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
}

/// 合同版本快照（ACTIVE / SUPERSEDED，禁止硬删除）
model ContractVersion {
  id            String    @id @default(cuid())
  caseId        String
  version       Int
  status        String
  changeOrderId String?
  snapshotJson  String
  createdAt     DateTime  @default(now())
  case          TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, version])
}

/// N5 采购合同/国内备货（无自有产线，向国内供应商采购；须关联已签销售合同，先销售后采购）
model ProcurementPlan {
  id                        String    @id @default(cuid())
  caseId                    String    @unique
  /// 本采购合同服务的销售/出口案件（须已达 N3 且已签销售合同）
  salesCaseId               String?
  poNo                      String?
  /// 供应商实际交付日期（计划交付，接口字段仍为 plannedArrival）
  plannedArrival            DateTime?
  /// 对照用：关联销售合同交货期快照；闸门优先用关联销售合同当前交货期
  contractDelivery          DateTime?
  poEvidenceStub            String?
  poEvidenceId              String?
  delayRegistered           Boolean   @default(false)
  delayTriggerCode          String?
  delayTriggerRef           String?
  delayReason               String?
  customerConsent           Boolean   @default(false)
  customerConsentEvidenceId String?
  /// 实际交付日期；闸门对照关联销售合同交货期，与供应商实际交付日期（plannedArrival）任一晚于交期即须登记延期
  actualArrival             DateTime?
  /// 采购合同/PO 金额（分）
  amountFen                 Int?
  currency                  String    @default("CNY")
  /// 已付货款（分）
  paidFen                   Int       @default(0)
  /// 约定向供应商付款日
  paymentDueAt              DateTime?
  /// 付清或最近一次付款日（分期时为最晚一期付款日）
  paidAt                    DateTime?
  /// FULL 一次性付清 / STAGED 分期支付
  paymentMode               String    @default("FULL")
  updatedAt                 DateTime  @updatedAt
  case                      TradeCase  @relation("CaseOwnsProcurement", fields: [caseId], references: [id], onDelete: Cascade)
  salesCase                 TradeCase? @relation("SalesLinkedProcurement", fields: [salesCaseId], references: [id], onDelete: SetNull)
  installments              ProcurementPaymentInstallment[]

  @@index([salesCaseId])
}

/// N5 采购货款分期：每一期独立比例/金额、触发条件与约定付款日
model ProcurementPaymentInstallment {
  id            String          @id @default(cuid())
  planId        String
  seq           Int
  /// 到货付款 / 尾款 / 一次性付清
  label         String?
  /// 基点，9000 = 90.00%
  percentBps    Int?
  /// 本期应付金额（分）；可与比例并存，保存时按比例或尾款轧差解析
  amountFen     Int?
  /// 付款条件/触发，如「货物到达交付地点之后支付」
  conditionText String?
  dueAt         DateTime?
  paidFen       Int             @default(0)
  paidAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  plan          ProcurementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, seq])
  @@index([planId])
}

/// HS 申报要素模板（演示用）
model HsTemplate {
  id                   String @id @default(cuid())
  hsCode               String @unique
  productName          String
  requiredElementsJson String
  unit                 String
  exportTaxName        String
}

/// N8 报关放行
model CustomsDeclaration {
  id                 String    @id @default(cuid())
  caseId             String    @unique
  hsCode             String?
  productName        String?
  declareElementsJson String   @default("{}")
  originCountry      String?
  originEvidenceType String?
  originEvidenceRef  String?
  originEvidenceId   String?
  unit               String?
  exportTaxName      String?
  eportStatus        String    @default("NOT_SYNCED")
  eportSyncRef       String?
  eportSyncedAt      DateTime?
  updatedAt          DateTime  @updatedAt
  case               TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

/// 中信保（出口信用保险）投保限额：挂案件，合同确认（N3）必填；变更管理（N4）再确认
model SinosurePolicy {
  id                String       @id @default(cuid())
  caseId            String
  nodeCode          String
  changeOrderId     String?
  evidenceId        String?
  evidenceRef       String?
  fileName          String?
  insuredLimitFen   Int
  currency          String       @default("USD")
  confirmedExisting Boolean      @default(false)
  createdAt         DateTime     @default(now())
  case              TradeCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  changeOrder       ChangeOrder? @relation(fields: [changeOrderId], references: [id], onDelete: SetNull)

  @@index([caseId, nodeCode])
}

/// 通用证据链（仅追加）
model Evidence {
  id        String    @id @default(cuid())
  caseId    String
  nodeCode  String
  kind      String
  ref       String?
  note      String?
  payload   String?
  createdAt DateTime  @default(now())
  case      TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, nodeCode])
}
